# Supabase (create project at supabase.com, then run supabase/schema.sql in SQL Editor)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# NextAuth (Auth.js v5). Same Google client is used for sign-in and Google Drive (add redirect URI: .../api/auth/callback/drive).
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
# For local dev, set so sign-in redirects work (optional; defaults to http://localhost:3000 when NODE_ENV !== production):
# NEXTAUTH_URL=http://localhost:3000
# Or: AUTH_URL=http://localhost:3000

# Super admin: only this email can add PMs and send system emails.
# Resource planning “Harvest people” list uses this user’s Harvest connection when set up (so PMs see the full team without each connecting Harvest).
SUPER_ADMIN_EMAIL=your-email@valtira.com

# Harvest OAuth (create app at https://id.getharvest.com/developers – redirect URL: https://yourdomain.com/api/auth/callback/harvest)
HARVEST_CLIENT_ID=
HARVEST_CLIENT_SECRET=

# Atlassian/Jira OAuth (create app at https://developer.atlassian.com/console/myapps/ – redirect URL: https://yourdomain.com/api/auth/callback/jira)
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Resend – optional; not used if you send invites and reports via Gmail (see below).
# RESEND_API_KEY=
# RESEND_FROM=

# Gmail: invite and report emails are sent via the signed-in user's Google account.
# Ensure Google is connected in Settings (and Gmail API enabled in Google Cloud Console).

# Cron: set CRON_SECRET in Vercel for /api/cron/run-automations (hourly). Vercel sends Authorization: Bearer CRON_SECRET.
CRON_SECRET=

# Gemini (project summary: mood, budget, next steps). Get key at https://aistudio.google.com/apikey
# If unset, summary shows gathered context as placeholder.
GEMINI_API_KEY=
