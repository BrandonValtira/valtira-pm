{
  "name": "valtira-pm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:clean": "rm -rf .next && lsof -ti :3000 | xargs kill -9 2>/dev/null; next dev -p 3000",
    "generate-icons": "node scripts/generate-icons.js",
    "seed-resource-planning": "node scripts/seed-resource-planning.cjs",
    "build": "npm run generate-icons && next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "npx vercel --prod --yes",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:env": "node scripts/supabase-env.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "next": "14.2.35",
    "next-auth": "^5.0.0-beta.30",
    "nodemailer": "^8.0.1",
    "pdf-parse": "^1.1.1",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.9.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "sharp": "^0.34.5",
    "supabase": "^2.76.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
